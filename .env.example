# ==========================================
# PROFESSOR ACADEMY - ENVIRONMENT TEMPLATE
# ==========================================

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL, Auth, Storage, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI (@google/genai)
GEMINI_API_KEY=your-gemini-api-key-here

# Cloudflare R2 / S3-Compatible Media Storage
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=professor-academy-storage
R2_PUBLIC_URL=https://storage.professoracademy.pk

# Resend / SMTP Transactional Email
RESEND_API_KEY=re_your_resend_key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@professoracademy.pk
SMTP_PASS=your-smtp-app-password
SMTP_FROM="Professor Academy <notifications@professoracademy.pk>"
